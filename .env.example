# VEIL — environment variables (example)
#
# Copy to .env and fill in values from the Supabase dashboard
# (Project Settings -> API). Never commit .env.
#
# The VITE_* values are publishable by design: Vite embeds them in the
# client bundle. The non-VITE_* values are server-side only and must never
# be exposed to the browser.

# Supabase project URL (server-side; also mirrored as VITE_SUPABASE_URL)
SUPABASE_URL=
# Supabase publishable (anon) key (server-side; also mirrored as VITE_SUPABASE_PUBLISHABLE_KEY)
SUPABASE_PUBLISHABLE_KEY=
# Supabase project reference ID (client-visible identifier, not a secret)
VITE_SUPABASE_PROJECT_ID=
# Supabase publishable (anon) key (client-visible by design)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Supabase project URL (client-visible by design)
VITE_SUPABASE_URL=
